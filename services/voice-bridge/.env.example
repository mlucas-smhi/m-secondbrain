PUBLIC_BASE_URL=https://your-bridge.example.com
ELEVENLABS_AGENT_ID=agent_replace_me
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_AGENT_NAME=11
ELEVENLABS_USER_NAME=Michael
ELEVENLABS_GREETING=Hello
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=replace_me
POC_ALLOWED_TO_NUMBER=replace_me
BRIDGE_API_KEY=replace_me
TWILIO_STATUS_CALLBACK_URL=https://your-project.supabase.co/functions/v1/twilio-call-status
LIVE_CALL_CONTEXT_URL=https://your-project.supabase.co/functions/v1/live-call-context
LIVE_CALL_MERGE_URL=https://your-project.supabase.co/functions/v1/live-call-merge
TURN_ENGINE_API_KEY=replace_with_runpod_secret_reference
LIVE_CALL_CONTEXT_POLL_SECONDS=2

# Conference execution remains disabled unless the durable approval boundary,
# TwiML App participant, and merge-control URL are configured.
CONFERENCE_MERGE_MODE=disabled
TWILIO_CONFERENCE_APP_SID=AP_replace_me

# disabled: relay only; count: metrics only; buffer: bounded RAM-only snippets.
VOICE_FORK_MODE=disabled
ROLLING_BUFFER_SECONDS=15

# Speaker matching is evidence-only. Observe mode requires both values below.
VERIFIER_MODE=disabled
SPEAKER_VERIFIER_URL=http://127.0.0.1:8090/verify
SPEAKER_VERIFIER_API_KEY=replace_me
VERIFIER_TIMEOUT_SECONDS=5
PORT=8080

# RunPod bootstrap. Store the tunnel token as a RunPod secret. The SSH public
# key is not secret; never put the corresponding private key on the pod.
RUNPOD_SSH_PUBLIC_KEY=ssh-ed25519 replace_with_your_public_key
CLOUDFLARE_TUNNEL_TOKEN=replace_with_runpod_secret_reference
VOICE_BRIDGE_SOURCE_REPO=/workspace/m-secondbrain-source
VOICE_BRIDGE_GIT_REF=df5ab372501e34f5e7211a9ab32f29f75eb23dbd
