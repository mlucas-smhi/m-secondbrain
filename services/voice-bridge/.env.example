PUBLIC_BASE_URL=https://your-bridge.example.com
ELEVENLABS_AGENT_ID=agent_replace_me
ELEVENLABS_API_KEY=replace_me
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=replace_me
POC_ALLOWED_TO_NUMBER=replace_me
