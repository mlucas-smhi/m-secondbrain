PUBLIC_BASE_URL=https://your-bridge.example.com
ELEVENLABS_AGENT_ID=agent_replace_me
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_AGENT_NAME=11
ELEVENLABS_USER_NAME=Michael
ELEVENLABS_GREETING=Hello
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=replace_me
POC_ALLOWED_TO_NUMBER=replace_me
BRIDGE_API_KEY=replace_me

# disabled: relay only; count: metrics only; buffer: bounded RAM-only snippets.
VOICE_FORK_MODE=disabled
ROLLING_BUFFER_SECONDS=15

# Speaker matching is evidence-only. Observe mode requires both values below.
VERIFIER_MODE=disabled
SPEAKER_VERIFIER_URL=http://127.0.0.1:8090/verify
SPEAKER_VERIFIER_API_KEY=replace_me
VERIFIER_TIMEOUT_SECONDS=5
PORT=8080
