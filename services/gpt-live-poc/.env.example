OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_VOICE=sage
GPT_LIVE_BACKEND_MODEL=gpt-5-mini
PORT=8090

# Keep "live" for the proven GitHub-memory canary. Set "realtime" only on a
# parallel canary configured for direct remote MCP access.
OPENAI_VOICE_API=live

# Realtime-only remote MCP configuration. The URL must be the standard
# Streamable HTTP endpoint (LiteGraph/Voltaic uses /mcp, not /rpc). Store the
# authorization value as a platform secret. Allow only read operations here.
MCP_SERVER_URL=
MCP_AUTHORIZATION=
# Recommended onboarding catalog: memory_search,memory_get,memory_store
MCP_ALLOWED_TOOLS=
# Switch only alongside the graph-enabled facade and provisioned scope.
MEMORY_SCHEMA_MODE=legacy
# Opt-in only after durable queue + background writer rollout succeeds:
# MEMORY_SCHEMA_MODE=conversational-capture.v1
# MCP_ALLOWED_TOOLS=memory_search,memory_get,memory_capture,memory_capture_status,memory_orientation

# Optional first-run onboarding gate. When all three values are present, the
# Realtime session exposes only code validation until the backend confirms it.
ONBOARDING_VERIFY_URL=https://PROJECT.supabase.co/functions/v1/verify-onboarding-code
ONBOARDING_RESUME_URL=https://PROJECT.supabase.co/functions/v1/resolve-onboarding-caller
ONBOARDING_WORKSPACE_ID=
ONBOARDING_API_KEY=
ONBOARDING_INVITE_ID=

# Optional read-only canonical memory lookup. Use a fine-grained token limited
# to this repository with Contents: read-only. Leave unset for voice-only.
GITHUB_TOKEN=
GITHUB_MEMORY_REPOSITORY=mlucas-smhi/m-secondbrain
GITHUB_MEMORY_REF=main

# Required before routing the Twilio number through /twilio/inbound.
TWILIO_AUTH_TOKEN=
ALLOWED_CALLER_NUMBER=
PUBLIC_BASE_URL=https://eleven-gptlive-poc.example.com
OPENAI_SIP_URI=sip:proj_example@sip.api.openai.com;secure=true
