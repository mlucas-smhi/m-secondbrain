{
	admin off
	auto_https off
}

:8080 {
	handle /health {
		rewrite * /
		reverse_proxy 127.0.0.1:8701
	}

	handle /mcp* {
		@unauthorized not header Authorization "Bearer {$MCP_EDGE_TOKEN}"
		respond @unauthorized 401

		reverse_proxy 127.0.0.1:8702
	}

	handle /memory-mcp* {
		@unauthorized not header Authorization "Bearer {$MCP_EDGE_TOKEN}"
		respond @unauthorized 401

		rewrite * /mcp
		reverse_proxy 127.0.0.1:8710
	}

	respond 404
}
